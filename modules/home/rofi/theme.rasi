// change on the text.
* {
    base:     #1e1e2e;
    mantle:   #181825;
    surface0: #313244;
    surface1: #45475a;
    text:     #cdd6f4;
    subtext:  #a6adc8;
    overlay:  #6c7086;
    blue:     #89b4fa;
    mauve:    #cba6f7;

    width: 980;
    // Same family as alacritty.
    font: "MesloLGS Nerd Font 16";

    background-color: transparent;
    text-color:       @text;
}

window {
    location: center;
    anchor:   center;
    // Same treatment as a hyprland window: 2px accent border, 6px radius.
    border:        2px;
    border-radius: 6px;
    border-color:  @blue;
    padding:       18px;
    // 0.7 alpha to match alacritty.
    background-color: #1e1e2eB3;
}

mainbox {
    // message is where rofi-calc shows the live result.
    children: [inputbar, message, listview, mode-switcher];
    spacing:  14px;
}

inputbar {
    children: [prompt, entry];
    spacing:  10px;
    padding:  0px;
}

prompt {
    background-color: @blue;
    text-color:       @base;
    padding:          8px 14px;
    border-radius:    6px;
}

entry {
    padding:          8px 12px;
    background-color: @mantle;
    border-radius:    6px;
    text-color:       @text;
    placeholder:      "Search";
    placeholder-color: @overlay;
}

listview {
    spacing:   4px;
    padding:   0px;
    columns:   1;
    lines:     10;
    scrollbar: false;
    // true, so filtering does not shrink the window a row at a time as you
    // type -- the list always reserves `lines` rows.
    fixed-height: true;
}

element {
    padding:       8px 12px;
    spacing:       12px;
    border-radius: 6px;
    text-color:    @subtext;
}

element selected {
    background-color: @surface0;
    text-color:       @blue;
}

element urgent {
    text-color: #f38ba8;
}

element active {
    text-color: @mauve;
}

element-icon {
    size:             28px;
    background-color: transparent;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    // make the matched substring obvious while typing
    highlight:        bold #cba6f7;
}

mode-switcher {
    spacing: 8px;
}

button {
    // Buttons are equal width, so the longest label decides whether any of
    // them truncate. A smaller face keeps every name whole. Set here, not on
    // mode-switcher: font does not cascade to the button children.
    font:          "MesloLGS Nerd Font 12";
    padding:       6px 8px;
    border-radius: 6px;
    text-color:    @overlay;
}

button selected {
    background-color: @surface0;
    text-color:       @mauve;
}

message {
    padding:          8px 12px;
    border-radius:    6px;
    background-color: @mantle;
}

textbox {
    text-color: @subtext;
}
