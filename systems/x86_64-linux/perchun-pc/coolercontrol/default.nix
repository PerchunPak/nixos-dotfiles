  devices = {
    cpu = "62d0b211088a0028a5ca06f6616ed0095d47bbb4e15f14210fd87ef706845a4c";
    gpu = "97910386cac9bfce54b2c224e4aaef42cd953440cb57f1ff5ff46ac183bf338e";
    nvme = "302a598a970e999f18ac9d50d60216d1fb4ac5c6ded0332e54b96ed23c21d07a";
    ram1 = "1a1f27e4c9a6f31abd2493cf107df416caa9c9605d453cc9e83e4d32cf7572b1";
    ram2 = "a2e99a9eb08cd6128353bbefd0ae69612316575ce4d4edf774b7f0e66cf10f97";
    motherboard = "00a4da18625f56275c89e2fcd25a83c08c5ad3326452fa7e252fcc8a89c92493"; # nct6799
