  profiles = {
    unmanaged = "0";
    cpu = "f7675f89-d9ab-4a1f-bbc0-07c051face6a";
    gpu = "8aa83c35-c8f8-4f44-baa2-8990442717fa";
    nvme = "aab1f69e-69ac-4cc3-bde2-a7d7dfe4a3b2";
