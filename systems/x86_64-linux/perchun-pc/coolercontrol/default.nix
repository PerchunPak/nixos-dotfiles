in
{
  # Holds the UI password, TLS certificate, fan calibrations and dashboard
  # layout (config-ui.json). config.toml and overrides.toml come from below.
  my.persistence.directories = [ "/etc/coolercontrol" ];

  my.coolercontrol = {
    enable = true;

    config = {
      devices = { };
      legacy690 = { };

      device-settings.${devices.motherboard} = {
        fan1.speed_fixed = 0;
        fan2.profile_uid = profiles.cpu;
        fan3.profile_uid = profiles.cpu;
        fan4.profile_uid = profiles.unmanaged;
        fan5.profile_uid = profiles.unmanaged;
        fan6.profile_uid = profiles.unmanaged;
        fan7.profile_uid = profiles.unmanaged;
      };

      profiles = [
        {
          uid = profiles.unmanaged;
          name = "Unmanaged";
          p_type = "Default";
          function = "0";
        }
        (graph profiles.cpu "CPU Curve" devices.cpu "temp1" [
          [
            0.0
            0
          ]
          [
            50.0
            0
          ]
          [
            60.0
            30
          ]
          [
            70.0
            80
          ]
          [
            100.0
            100
          ]
        ])
        (graph profiles.gpu "GPU Curve" devices.gpu "temp2" [
          [
            0.0
            0
          ]
          [
            50.0
            0
          ]
          [
            65.0
            30
          ]
          [
            80.0
            80
          ]
          [
            100.0
            100
          ]
        ])
        (graph profiles.nvme "NVME Curve" devices.nvme "temp1" [
          [
            0.0
            0
          ]
          [
            50.0
            0
          ]
          [
            60.0
            30
          ]
          [
            70.0
            80
          ]
          [
            75.0
            100
          ]
          [
            100.0
            100
          ]
        ])
        {
          uid = profiles.caseFans;
          name = "Case Fans";
          p_type = "Mix";
          function_uid = "0";
          member_profile_uids = [
            profiles.cpu
            profiles.gpu
            profiles.nvme
          ];
          mix_function_type = "Max";
        }
        (graph profiles.ram1 "RAM 1 Curve" devices.ram1 "temp1" ramCurve)
        (graph profiles.ram2 "RAM 2 Curve" devices.ram2 "temp1" ramCurve)
      ];

      functions = [
        {
          uid = "0";
          name = "Default Function";
          f_type = "Identity";
        }
      ];

      settings = {
        apply_on_boot = true;
        liquidctl_integration = true;
        hide_duplicate_devices = true;
        no_init = false;
        startup_delay = 2;
        thinkpad_full_speed = false;
        compress_payload = true;
        drivetemp_suspend = false;

        ${devices.nvme} = {
          name = "KINGSTON SKC3000D2048G";
          disable = false;
          channel_settings.temp3 = {
            label = "Sensor 2";
            disabled = true;
          };
        };
      };
    };

    overrides.devices.${devices.motherboard} = {
      device_name = "nct6799";
      channels = {
        fan1.label = "Case fans";
        fan2.label = "CPU fan";
        fan3.label = "Pump Fans";
        fan4.label = "PSU?";
      };
    };
  };
}
